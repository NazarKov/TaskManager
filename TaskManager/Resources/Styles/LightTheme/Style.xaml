<ResourceDictionary x:Class="TaskManager.Resources.Styles.LightTheme.Style"
                    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">


    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextMain}" />
    </Style>

    <Style x:Key="PageSubtitle" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
    </Style>

    <Style x:Key="TaskTitle" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextMain}" />
    </Style>

    <Style x:Key="MutedText" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="SmallText" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- Картки -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="Stroke" Value="{StaticResource CardBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="TaskCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="14" />
    </Style>

    <!-- Кнопки -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="#FFFFFF" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceSecondary}" />
        <Setter Property="TextColor" Value="{StaticResource TextMain}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <Style x:Key="FilterButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceSecondary}" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Поля вводу -->
    <Style x:Key="SearchStyle" TargetType="SearchBar">
        <Setter Property="BackgroundColor" Value="{StaticResource InputBackground}" />
        <Setter Property="TextColor" Value="{StaticResource TextMain}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}" />
        <Setter Property="CancelButtonColor" Value="{StaticResource TextSecondary}" />
    </Style>

    <!-- Статус -->
    <Style x:Key="StatusBadge" TargetType="Border">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceSecondary}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="8" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Поля форми -->
    <Style x:Key="InputStyle" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="{StaticResource InputBackground}" />
        <Setter Property="TextColor" Value="{StaticResource TextMain}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}" />
    </Style>
</ResourceDictionary>