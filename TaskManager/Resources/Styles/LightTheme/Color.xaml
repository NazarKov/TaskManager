<ResourceDictionary x:Class="TaskManager.Resources.Styles.LightTheme.Color" 
                    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

 
    <Color x:Key="Primary">#8B80F9</Color>
    <Color x:Key="PrimaryDark">#7469E8</Color>
    <Color x:Key="PrimaryLight">#29264A</Color>
 
    <Color x:Key="Background">#18191D</Color>
    <Color x:Key="Surface">#222329</Color>
    <Color x:Key="SurfaceSecondary">#2A2B32</Color>
    <Color x:Key="InputBackground">#2C2D34</Color>
 
    <Color x:Key="TextMain">#F1F1F5</Color>
    <Color x:Key="TextSecondary">#B0B1BD</Color>
    <Color x:Key="TextMuted">#777985</Color>
 
    <Color x:Key="CardBorder">#35363F</Color>
    <Color x:Key="InputBorder">#41424D</Color>
 
    <Color x:Key="Success">#45C49A</Color>
    <Color x:Key="Warning">#E8AD55</Color>
    <Color x:Key="Danger">#E66B78</Color>
 
    <Color x:Key="SuccessLight">#203B34</Color>
    <Color x:Key="WarningLight">#403426</Color>
    <Color x:Key="DangerLight">#40282E</Color>
</ResourceDictionary>